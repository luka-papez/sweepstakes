{
    "name": "Sweepstakes",
    "image": "mcr.microsoft.com/devcontainers/php:8.4",
    "containerEnv": {
        "XDEBUG_MODE": "off"
    },
    "postCreateCommand": "composer setup",
    "postStartCommand": "nohup bash -c 'php artisan serve > /tmp/serve.log 2>&1 &' > /dev/null 2>&1",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Sweepstakes",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ]
        }
    }
}
