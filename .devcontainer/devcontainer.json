{
    "name": "Sweepstakes",
    "image": "mcr.microsoft.com/devcontainers/php:8.4",
    "postCreateCommand": "composer setup",
    "postAttachCommand": "composer dev",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Sweepstakes",
            "onAutoForward": "openPreview"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client"
            ],
            "settings": {
                // The interview is done without AI assistants.
                "github.copilot.enable": { "*": false },
                "chat.disableAIFeatures": true
            }
        }
    }
}
